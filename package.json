{
  "name": "signalk-tides",
  "version": "2.1.2",
  "description": "Tidal predictions for the vessel's position, powered by Neaps.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "prepack": "npm run build",
    "preview": "vite preview",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "vitest run --config vitest.config.node.ts",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "test:run": "npm run test:node && npm run test:browser"
  },
  "keywords": [
    "signalk-webapp",
    "signalk-node-server-plugin"
  ],
  "author": {
    "name": "Brandon Keepers",
    "url": "https://github.com/bkeepers"
  },
  "contributors": [
    {
      "name": "Joachim Bakke"
    },
    {
      "name": "Scott Bender"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@neaps/api": "^0.6.0",
    "@neaps/react": "^0.1.1",
    "@signalk/server-api": "^2.28.0",
    "express": "^5.2.1",
    "neaps": "^0.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^5.19.0",
    "pkg-pr-new": "^0.0.75",
    "playwright": "^1.58.2",
    "react-map-gl": "^8.1.0",
    "signalk-server": "^2.13.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/signalk-tides.git"
  },
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "appIcon": "icon.svg",
    "displayName": "Tides"
  }
}
